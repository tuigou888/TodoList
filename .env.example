# 环境变量配置示例
# 复制此文件为 .env 并填写实际配置

# Flask 密钥（生产环境必须修改，建议使用随机字符串，至少 16 位）
SECRET_KEY=your-very-long-and-random-secret-key-change-this-in-production

# 站点对外访问地址（用于邮件里的链接，部署到域名后务必修改）
BASE_URL=http://localhost:5145

# 会话 Cookie 是否只允许 HTTPS（生产环境建议 True）
SESSION_COOKIE_SECURE=False
# 会话 Cookie 的 SameSite 策略
SESSION_COOKIE_SAMESITE=Lax
# 请求体大小上限（字节）
MAX_CONTENT_LENGTH=2097152

# ==================== 邮件服务 ====================
# 是否启用邮件服务（True/False）
MAIL_ENABLED=True

# SMTP 服务器配置
# QQ 邮箱示例（STARTTLS 587）
MAIL_SERVER=smtp.qq.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
# 连接与读写超时（秒）
MAIL_TIMEOUT=15
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=your-smtp-auth-code

# 发件人邮箱
MAIL_DEFAULT_SENDER=your-email@example.com

# 已废弃：新版本按每个用户在“设置”页配置的提醒时间发送每日提醒
# MAIL_REMINDER_HOUR=0

# ==================== 跨域配置（可选） ====================
CORS_ENABLED=True
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5145

# ==================== 管理员初始化（仅 migrate_db.py 使用） ====================
# 不设置 ADMIN_PASSWORD 时会生成随机临时密码并打印到终端
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me
# ADMIN_EMAIL=admin@example.com

# 其他常用邮箱配置示例：
#
# 163/126 邮箱（SSL 465，注意 MAIL_USE_TLS 必须为 False）
# MAIL_SERVER=smtp.163.com
# MAIL_PORT=465
# MAIL_USE_TLS=False
# MAIL_USE_SSL=True
# MAIL_USERNAME=your-email@163.com
# MAIL_PASSWORD=your-smtp-password
#
# Gmail（STARTTLS 587）
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USE_SSL=False
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
